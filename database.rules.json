{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "approvedMembers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && !data.exists()) || root.child('roles').child(auth.uid).val() == 'admin')"
      }
    },
    "pendingMembers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('roles').child(auth.uid).val() == 'admin')"
      }
    },
    "roles": {
      ".read": false,
      ".write": "auth != null && root.child('roles').child(auth.uid).val() == 'admin'"
    }
  }
}

